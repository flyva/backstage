DATABASE_URL="mysql://user:password@127.0.0.1:3306/backstage"
# Notifications push : générer avec  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:toi@exemple.fr"
# Secret du rappel quotidien (appelé par cron/systemd) : openssl rand -hex 24
CRON_SECRET=""
# Quota de la galerie en Mo (défaut 2048)
# GALLERY_MAX_MB=2048
# Code d'invitation exigé à l'inscription (recommandé dès que le site est public). Vide = inscription libre.
# REGISTRATION_CODE=""

# --- Connexion avec Microsoft (Office 365) : voir DEPLOY.md, section 11 ---
# Sans ces variables, le bouton « Se connecter avec Microsoft » n'apparaît pas.
# MS_CLIENT_ID=""                 # « ID d'application (client) » de l'enregistrement Entra ID
# MS_CLIENT_SECRET=""             # valeur du secret client (expire : voir la date dans Azure)
# ALLOWED_EMAIL_DOMAINS="3is.fr"  # SEULES ces adresses peuvent se connecter (Microsoft) ou s'inscrire ; l'organisation est retrouvée toute seule
# APP_URL="https://backstage.exemple.fr"   # adresse publique du site (obligatoire en production)
# LOCAL_REGISTRATION=off          # « off » : plus d'inscription par mot de passe, seulement Microsoft

# --- Connexion avec Google (comptes personnels validés par un admin) : voir DEPLOY.md, section 12 ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Temps en voiture avec embouteillages en direct (clé gratuite TomTom, voir DEPLOY.md section 13)
# TOMTOM_API_KEY=""

# E-mails (mot de passe oublié). Sans MAIL_HOST, le lien est écrit dans la console du serveur (développement).
# MAIL_HOST=""
# MAIL_PORT="587"
# MAIL_USER=""
# MAIL_PASS=""
# MAIL_FROM="Backstage <noreply@ton-domaine.fr>"

