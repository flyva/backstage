# /opt/backstage/.env : lu par systemd et par install.sh. Droits : chmod 600, propriétaire backstage.

# Base MariaDB/MySQL déjà présente sur le Pi (crée une base et un utilisateur dédiés à Backstage).
DATABASE_URL="mysql://backstage:CHANGE_MOI@127.0.0.1:3306/backstage"

# Notifications push : générer avec  npx web-push generate-vapid-keys  (sur le PC)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact transmis aux services de push (Google, Apple…) : une adresse que tu acceptes de partager.
VAPID_SUBJECT="mailto:contact@exemple.fr"

# Secret du rappel quotidien :  openssl rand -hex 24
CRON_SECRET=""

# Quota de la galerie photo/vidéo en Mo (la carte SD est limitée)
GALLERY_MAX_MB=2048

# Code d'invitation exigé à l'inscription : À DÉFINIR avant d'ouvrir le site (sinon n'importe qui peut créer un compte).
REGISTRATION_CODE=""

# --- Connexion avec Microsoft (Office 365) : voir DEPLOY.md, section 11 ---
# Sans ces variables, le bouton « Se connecter avec Microsoft » n'apparaît pas.
# MS_CLIENT_ID=""                 # « ID d'application (client) » de l'enregistrement Entra ID
# MS_CLIENT_SECRET=""             # valeur du secret client (expire : voir la date dans Azure)
# ALLOWED_EMAIL_DOMAINS="3is.fr"  # SEULES ces adresses peuvent se connecter (Microsoft) ou s'inscrire ; l'organisation est retrouvée toute seule
# APP_URL="https://backstage.exemple.fr"   # adresse publique du site (obligatoire en production)
# LOCAL_REGISTRATION=off          # « off » : plus d'inscription par mot de passe, seulement Microsoft

# --- Connexion avec Google (comptes personnels validés par un admin) : voir DEPLOY.md, section 12 ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
