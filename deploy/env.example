# /opt/backstage/.env : lu par systemd et par install.sh. Droits : chmod 600, propriétaire backstage.

# Base MariaDB/MySQL déjà présente sur le Pi (crée une base et un utilisateur dédiés à Backstage).
DATABASE_URL="mysql://backstage:CHANGE_MOI@127.0.0.1:3306/backstage"

# Notifications push : générer avec  npx web-push generate-vapid-keys  (sur le PC)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact transmis aux services de push (Google, Apple…) : une adresse que tu acceptes de partager.
VAPID_SUBJECT="mailto:contact@exemple.fr"

# Secret du rappel quotidien :  openssl rand -hex 24
CRON_SECRET=""

# Quota de la galerie photo/vidéo en Mo (la carte SD est limitée)
GALLERY_MAX_MB=2048

# Code d'invitation exigé à l'inscription : À DÉFINIR avant d'ouvrir le site (sinon n'importe qui peut créer un compte).
REGISTRATION_CODE=""
